# ============================================================
# 体积大、且都能用脚本自动下载的东西 —— 不要提交
# ============================================================

# Python 依赖（约 471 MB）：用 `python fetch_wheels.py --core` 装
libs/

# 模型与下载缓存（约 3.4 GB）：
#   ct2-small / ct2-medium   -> python fetch_model.py small medium
#   ocr-latin                -> python fetch_ocr_model.py
#   nllb / m2m               -> python fetch_nllb.py
tmp/models/
tmp/wheels/
tmp/whl/
tmp/pip-*/

# ============================================================
# 个人数据 —— 不要提交
# ============================================================

# 翻译记录与直播字幕（含真实直播内容）
记录/

# 个人偏好（市场/品类/引擎/框选区域等）
settings.json

# 翻译缓存、测试音频
tmp/*cache*.json
# 本机一次性辅助脚本（如权限清理）
tmp/_*
tmp/*.wav
tmp/g*.txt
# 打包用的 Python 安装程序（25 MB，不该进仓库；打包脚本会提示怎么下）
tmp/*.exe

# tools/collect_report.py 生成的诊断报告（含本机路径和设备名）
诊断报告.txt
自检结果.txt

# ============================================================
# 工具跑出来的结果数据 —— 不要提交
# ============================================================
# 每次跑数值都不一样（耗时、输出样本），提交进来只会一直显示"已修改"。
# 注：audit_translate.py / m2m_probe.py 现在把结果写进 tmp\，
# tools\ 下那几个是早期留下的历史副本，已从版本库移除（文件本身保留在本地）。
tools/audit_translate_results.json
tools/m2m_probe_result*.json
tmp/audit_translate_results.json
tmp/m2m_probe_result*.json

# ============================================================
# Python 常规
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
*.log

# ============================================================
# 体积大、且都能用脚本自动下载的东西 —— 不要提交
# ============================================================

# Python 依赖（约 471 MB）：用 `python fetch_wheels.py --core` 装
libs/

# 模型与下载缓存（约 3.4 GB）：
#   ct2-small / ct2-medium   -> python fetch_model.py small medium
#   ocr-latin                -> python fetch_ocr_model.py
#   nllb / m2m               -> python fetch_nllb.py
tmp/models/
tmp/wheels/
tmp/whl/
tmp/pip-*/

# ============================================================
# 个人数据 —— 不要提交
# ============================================================

# 翻译记录与直播字幕（含真实直播内容）
记录/

# 个人偏好（市场/品类/引擎/框选区域等）
settings.json

# 翻译缓存、测试音频
tmp/*cache*.json
tmp/*.wav
tmp/g*.txt

# ============================================================
# Python 常规
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ============================================================
# 编辑器 / 系统
# ============================================================
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
*.log
